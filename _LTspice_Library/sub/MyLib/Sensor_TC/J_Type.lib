*** J THERMOCOUPLE SUBCIRCUIT ************************************
* https://www.ecircuitcenter.com/Circuits/Thermocouple/Thermocouple1.htm
*     Temperature Range (°C)
*        -210.000 to 760.000 
*         760.000 to 1200.000
*
*	T_JUNC(C) - 1    T_REF(C) - 2   V_TC+(V) - 3  V_TC-(V) - 4
* 
.SUBCKT TC_J 1 2 3 4
*
* Type-J Thermocouple
* Polynomial model: V = S(Bn*T^n)  (mV vs °C)
*
* Junction EMF (V_TJ) vs. temperature (°C)
E_TJ 5 0 VALUE = {
+  IF(V(1) < 760,
+    (  0.503811878150E-01*V(1)    +
+       0.304758369300E-04*V(1)**2 +
+      -0.856810657200E-07*V(1)**3 +
+       0.132281952950E-09*V(1)**4 +
+      -0.170529583370E-12*V(1)**5 +
+       0.209480906970E-15*V(1)**6 +
+      -0.125383953360E-18*V(1)**7 +
+       0.156317256970E-22*V(1)**8 ),
+    (  0.296456256810E+03          +
+      -0.149761277860E+01*V(1)     +
+       0.317871039240E-02*V(1)**2  +
+      -0.318476867010E-05*V(1)**3  +
+       0.157208190040E-08*V(1)**4  +
+      -0.306913690560E-12*V(1)**5  )
+  )
+ }
*
* Reference EMF (V_TR) vs. temperature (°C)
E_TR 6 0 VALUE = {
+  IF(V(2) < 760,
+    (  0.503811878150E-01*V(2)    +
+       0.304758369300E-04*V(2)**2 +
+      -0.856810657200E-07*V(2)**3 +
+       0.132281952950E-09*V(2)**4 +
+      -0.170529583370E-12*V(2)**5 +
+       0.209480906970E-15*V(2)**6 +
+      -0.125383953360E-18*V(2)**7 +
+       0.156317256970E-22*V(2)**8 ),
+    (  0.296456256810E+03          +
+      -0.149761277860E+01*V(2)     +
+       0.317871039240E-02*V(2)**2  +
+      -0.318476867010E-05*V(2)**3  +
+       0.157208190040E-08*V(2)**4  +
+      -0.306913690560E-12*V(2)**5  )
+  )
+ }
*
*
* Thermocouple output: (V_TJ - V_TR)
* DIVIDE BY 1000 TO CONVERT V to mV
E_TC 3 4 VALUE = { (V(5) - V(6)) / 1000 }
.ENDS TC_J